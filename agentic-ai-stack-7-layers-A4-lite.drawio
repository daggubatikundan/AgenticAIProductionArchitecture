        <mxCell id="n165" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n111" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n166" value="authenticated, filtered, scoped request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A6B7C;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n111" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n167" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n119" target="n127"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n168" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n119" target="n127"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n169" value="reasoning step + tool schemas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A6B7C;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n119" target="n127"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n170" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n127" target="n135"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n171" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n127" target="n135"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n172" value="chosen tool call, structured output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A6B7C;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n127" target="n135"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n173" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n135" target="n143"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n174" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n135" target="n143"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n175" value="grounded, cited result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A6B7C;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n135" target="n143"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n176" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.32;exitY=1;exitDx=0;exitDy=0;entryX=0.32;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n143" target="n151"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n177" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.78;exitY=1;exitDx=0;exitDy=0;entryX=0.78;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n143" target="n151"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n178" value="decisions, traces, cost signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5A6B7C;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=0;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n143" target="n151"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n179" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#2C6FAF;strokeWidth=2;fontSize=9;fontColor=#37474F;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n151" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n180" value="corrections &amp;#8594; golden set &amp;#8594; eval gate &amp;#8594; canary &amp;#8594; promote" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=1;fontColor=#2C6FAF;horizontal=0;" vertex="1" parent="1"><mxGeometry x="6" y="385" width="16" height="320" as="geometry"/></mxCell>
        <mxCell id="n181" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFCFC;strokeColor=#B23A55;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="890" y="76" width="255" height="696" as="geometry"/></mxCell>
        <mxCell id="n182" value="SECURITY &amp;amp; GOVERNANCE SPINE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#B23A55;" vertex="1" parent="1"><mxGeometry x="902" y="88" width="231" height="16" as="geometry"/></mxCell>
        <mxCell id="n183" value="Enforced at every layer, not bolted on at one" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;fontStyle=0;fontColor=#8A6B70;" vertex="1" parent="1"><mxGeometry x="902" y="105" width="231" height="14" as="geometry"/></mxCell>
        <mxCell id="n184" value="&lt;b&gt;Identity &amp;amp; Access&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7C&quot;&gt;SSO &amp;#183; per-agent identity &amp;#183; least privilege &amp;#183; JIT admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9A5AE;strokeWidth=2;fontSize=9;fontColor=#12263A;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;" vertex="1" parent="1"><mxGeometry x="902" y="126" width="231" height="116" as="geometry"/></mxCell>
        <mxCell id="n185" value="&lt;b&gt;Data Protection&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7C&quot;&gt;TLS 1.3 &amp;#183; field encryption &amp;#183; tokenization &amp;#183; managed keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9A5AE;strokeWidth=2;fontSize=9;fontColor=#12263A;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;" vertex="1" parent="1"><mxGeometry x="902" y="252" width="231" height="116" as="geometry"/></mxCell>
        <mxCell id="n186" value="&lt;b&gt;Network Isolation&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7C&quot;&gt;private endpoints &amp;#183; no public egress &amp;#183; trust zones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9A5AE;strokeWidth=2;fontSize=9;fontColor=#12263A;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;" vertex="1" parent="1"><mxGeometry x="902" y="378" width="231" height="116" as="geometry"/></mxCell>
        <mxCell id="n187" value="&lt;b&gt;AI-Specific Controls&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7C&quot;&gt;injection filters &amp;#183; tool-call authz &amp;#183; blast radius &amp;#183; pinned versions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9A5AE;strokeWidth=2;fontSize=9;fontColor=#12263A;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;" vertex="1" parent="1"><mxGeometry x="902" y="504" width="231" height="116" as="geometry"/></mxCell>
        <mxCell id="n188" value="&lt;b&gt;Audit &amp;amp; Governance&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5A6B7C&quot;&gt;zero retention &amp;#183; immutable decision log &amp;#183; review board &amp;#183; kill switch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D9A5AE;strokeWidth=2;fontSize=9;fontColor=#12263A;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;" vertex="1" parent="1"><mxGeometry x="902" y="630" width="231" height="116" as="geometry"/></mxCell>
        <mxCell id="n189" value="&lt;b&gt;Thirty-second version:&lt;/b&gt; requests enter through a guarded gateway, a durable graph decides what to do, a routed model reasons, MCP tools fetch truth and act behind human gates, and everything is traced and evaluated so the next version has to earn its promotion." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=0;fontColor=#40566B;" vertex="1" parent="1"><mxGeometry x="45" y="786" width="1080" height="28" as="geometry"/></mxCell>
        <mxCell id="n190" value="Component notes &amp;#8212; one line each" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontStyle=1;fontColor=#0B2545;" vertex="1" parent="1"><mxGeometry x="45" y="846" width="1080" height="24" as="geometry"/></mxCell>
        <mxCell id="n191" value="Read the layer names off the diagram; use these when the interviewer picks a layer to go deep on." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=9;fontStyle=0;fontColor=#40566B;" vertex="1" parent="1"><mxGeometry x="45" y="870" width="1080" height="16" as="geometry"/></mxCell>
        <mxCell id="n192" value="&lt;b&gt;1 &amp;#183; Experience &amp;amp; Entry&lt;/b&gt;&lt;br&gt;&lt;b&gt;Chat UI&lt;/b&gt; &amp;#8212; conversational surface inside the app the user already uses&lt;br&gt;&lt;b&gt;REST / SDK API&lt;/b&gt; &amp;#8212; programmatic entry so other services can invoke an agent&lt;br&gt;&lt;b&gt;IDE &amp;amp; CLI Agent&lt;/b&gt; &amp;#8212; Claude Code, used to build and maintain the stack itself&lt;br&gt;&lt;b&gt;Events &amp;amp; Schedules&lt;/b&gt; &amp;#8212; webhooks and cron start runs with no human asking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EEF1FB;strokeColor=#3D51A8;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="894" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n193" value="&lt;b&gt;2 &amp;#183; Gateway &amp;amp; Guardrails&lt;/b&gt;&lt;br&gt;&lt;b&gt;API Gateway&lt;/b&gt; &amp;#8212; one front door: routing, TLS, quotas, rate limits, semantic cache&lt;br&gt;&lt;b&gt;OAuth 2.1 / OIDC&lt;/b&gt; &amp;#8212; the token carries the caller's real scopes, not a shared service account&lt;br&gt;&lt;b&gt;Injection Filter&lt;/b&gt; &amp;#8212; classifiers on untrusted input and retrieved text before the model sees it&lt;br&gt;&lt;b&gt;PII Redaction&lt;/b&gt; &amp;#8212; sensitive fields swapped for surrogates; downstream sees minimum necessary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E4F3F0;strokeColor=#1F857A;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="894" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n194" value="&lt;b&gt;3 &amp;#183; Agent Runtime &amp;amp; Orchestration&lt;/b&gt;&lt;br&gt;&lt;b&gt;LangGraph&lt;/b&gt; &amp;#8212; supervisor graph: nodes, edges, shared state, memory tiers, sub-agent fan-out&lt;br&gt;&lt;b&gt;Durable Workflow&lt;/b&gt; &amp;#8212; checkpoint, retry, compensate. A run survives restart instead of starting over&lt;br&gt;&lt;b&gt;Plan &amp;#8594; Execute &amp;#8594; Verify&lt;/b&gt; &amp;#8212; a critic scores groundedness; a failed verify replans rather than ships&lt;br&gt;&lt;b&gt;Human-in-the-Loop Gate&lt;/b&gt; &amp;#8212; the run parks and resumes on a human decision. This is what makes autonomy shippable" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E7F4E9;strokeColor=#2E7D52;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="1042" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n195" value="&lt;b&gt;4 &amp;#183; Model &amp;amp; Inference&lt;/b&gt;&lt;br&gt;&lt;b&gt;Model Router&lt;/b&gt; &amp;#8212; picks a model per step by cost, latency and difficulty, with a documented fallback&lt;br&gt;&lt;b&gt;Claude Opus&lt;/b&gt; &amp;#8212; hardest reasoning: ambiguity, long-horizon planning, edge cases&lt;br&gt;&lt;b&gt;Claude Sonnet&lt;/b&gt; &amp;#8212; the high-volume workhorse for structured output and tool use&lt;br&gt;&lt;b&gt;Claude Haiku&lt;/b&gt; &amp;#8212; classification, routing, cheap batch. Hosted on Bedrock or Foundry with prompt caching" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDF2DF;strokeColor=#B07D0A;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="1042" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n196" value="&lt;b&gt;5 &amp;#183; Tools, Context &amp;amp; Retrieval&lt;/b&gt;&lt;br&gt;&lt;b&gt;MCP Server Fleet&lt;/b&gt; &amp;#8212; systems as typed, permissioned tools from a signed, versioned registry&lt;br&gt;&lt;b&gt;Hybrid Retrieval&lt;/b&gt; &amp;#8212; keyword plus vector, then rerank. Beats pure vector search on real corpora&lt;br&gt;&lt;b&gt;Vector Store&lt;/b&gt; &amp;#8212; the index, with row and column policy, refreshed on a freshness SLA&lt;br&gt;&lt;b&gt;Sandboxed Code Exec&lt;/b&gt; &amp;#8212; generated code runs isolated: no network, no filesystem, hard timeout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F1ECFB;strokeColor=#6B4FBB;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="1190" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n197" value="&lt;b&gt;6 &amp;#183; Action &amp;amp; Integration&lt;/b&gt;&lt;br&gt;&lt;b&gt;Approval Workbench&lt;/b&gt; &amp;#8212; a human accepts, edits or rejects with a reason. The reason is training data&lt;br&gt;&lt;b&gt;System Write-back&lt;/b&gt; &amp;#8212; scoped writes through MCP, dual control on anything sensitive&lt;br&gt;&lt;b&gt;n8n Automation&lt;/b&gt; &amp;#8212; downstream steps, queues, schedules, notifications. Unchanged on either cloud&lt;br&gt;&lt;b&gt;Idempotency &amp;amp; Rollback&lt;/b&gt; &amp;#8212; every write carries a key and a compensating action. Retries are safe by design" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FCEBEE;strokeColor=#B23A55;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="1190" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n198" value="&lt;b&gt;7 &amp;#183; Observability &amp;amp; Eval&lt;/b&gt;&lt;br&gt;&lt;b&gt;LangSmith Tracing&lt;/b&gt; &amp;#8212; a span per agent hop and tool call, one trace ID end to end, replay of a bad run&lt;br&gt;&lt;b&gt;Evals &amp;amp; Golden Sets&lt;/b&gt; &amp;#8212; per-agent golden sets gate every promotion. No eval, no deploy&lt;br&gt;&lt;b&gt;Groundedness &amp;amp; Citations&lt;/b&gt; &amp;#8212; an unsupported claim is blocked, not softened. Every output traces to a source&lt;br&gt;&lt;b&gt;Cost &amp;amp; Token Meters&lt;/b&gt; &amp;#8212; cost per run and per outcome, with token budgets enforced at the router" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E9F1FA;strokeColor=#2C6FAF;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="1338" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n199" value="&lt;b&gt;Security &amp;amp; Governance Spine&lt;/b&gt;&lt;br&gt;&lt;b&gt;Identity &amp;amp; Access&lt;/b&gt; &amp;#8212; SSO, per-agent workload identity, least-privilege tool scopes, no standing admin&lt;br&gt;&lt;b&gt;Data Protection&lt;/b&gt; &amp;#8212; TLS 1.3 and mTLS, field-level encryption, tokenization, managed keys with rotation&lt;br&gt;&lt;b&gt;Network Isolation&lt;/b&gt; &amp;#8212; private endpoints only, no public egress, segmented trust zones&lt;br&gt;&lt;b&gt;AI-Specific Controls&lt;/b&gt; &amp;#8212; injection classifiers, tool-call authorization at the MCP boundary, blast-radius limits on write tools, pinned and signed model and prompt versions&lt;br&gt;&lt;b&gt;Audit &amp;amp; Governance&lt;/b&gt; &amp;#8212; zero data retention, immutable log of prompt, tool call and decision, review board on every promotion, one-click kill switch per agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFCFC;strokeColor=#B23A55;strokeWidth=2;fontSize=9;fontColor=#1A2733;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="590" y="1338" width="525" height="138" as="geometry"/></mxCell>
        <mxCell id="n200" value="&lt;b&gt;Whiteboard in three minutes.&lt;/b&gt; &amp;#160;1) Seven numbered rectangles, layer names only. &amp;#160;2) One tall rectangle on the right with arrows into every layer: Security &amp;amp; Governance Spine. &amp;#160;3) A down-arrow between each pair, plus one dashed arrow from 7 back up to 3 labelled eval, canary, promote. &amp;#160;Only then fill in names. That 7-to-3 loop is the piece most candidates leave out, and it is usually what the question is really about." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F4F7FA;strokeColor=#8FA0B0;strokeWidth=2;fontSize=9;fontColor=#243B53;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="45" y="1492" width="1080" height="48" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
